---
import { services } from "../data/services";
import ServiceCard from "./ServiceCard.astro";
---

<section class="services section container" id="servicios" aria-labelledby="services-title">
  <div class="services__intro">
    <p class="eyebrow">Lo que hacemos</p>
    <h2 id="services-title">Un estándar técnico para cada desafío.</h2>
    <a class="text-link" href="/servicios/">Ver todos los servicios <span aria-hidden="true">↗</span></a>
  </div>
  <div class="services__list">
    {services.map((service) => <ServiceCard service={service} />)}
  </div>
</section>
