---
import { services } from "../data/services";
import ServiceCard from "./ServiceCard.astro";
---

<section class="services section container" id="servicios" aria-labelledby="services-title">
  <div class="services__intro">
    <p class="eyebrow">Lo que hacemos</p>
    <h2 id="services-title">Un estándar técnico para cada desafío.</h2>
    <a class="text-link" href="/servicios/">Ver todos los servicios <span aria-hidden="true">↗</span></a>
  </div>
  <div class="services__list">
    {services.map((service) => <ServiceCard service={service} />)}
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 9vw, 10rem);
  }

  .eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 10ch;
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: -0.05em;
    line-height: var(--leading-tight);
  }

  .text-link {
    display: inline-flex;
    gap: var(--space-3);
    margin-top: var(--space-12);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    color: var(--color-accent);
  }

  @media (max-width: 48rem) {
    .services {
      display: block;
    }

    .services__list {
      margin-top: var(--space-12);
    }
  }
</style>
