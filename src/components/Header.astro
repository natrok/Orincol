---
import { headerNavigation } from "../data/navigation";
import { services } from "../data/services";
import MobileMenu from "./MobileMenu.astro";

interface Props {
  /**
   * When true, the header renders transparent (light text) at the top of the
   * page and only gains a solid, blurred background once the user scrolls.
   * Intended for pages with a full-bleed hero image/video behind the header.
   */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

// Editorial labels used only in the mega menu column headings; the linked
// slug/areas still come from the single source of truth in `data/services.ts`.
const megaMenuLabels: Record<string, string> = {
  consultoria: "Consultoría y Diseño",
  construccion: "Construcción",
  interventoria: "Interventoría",
  alquiler: "Alquiler",
};

function slugify(text: string): string {
  return text
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}
---

<header class="site-header" id="site-header" data-transparent={transparent ? "true" : "false"}>
  <div class="site-header__inner container">
    <a href="/" class="site-header__logo" aria-label="ORINCOL — Ir al inicio">
      ORINCOL
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul class="site-header__nav-list">
        {
          headerNavigation.map((item) =>
            item.children ? (
              <li class="site-header__nav-item has-mega" data-mega-item>
                <button
                  type="button"
                  class="site-header__nav-link"
                  aria-expanded="false"
                  aria-controls="mega-servicios"
                  data-mega-toggle
                >
                  {item.label}
                  <svg class="site-header__chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="mega-menu" id="mega-servicios" data-mega-panel>
                  <div class="mega-menu__inner container">
                    <div class="mega-menu__intro">
                      <p class="mega-menu__eyebrow">Servicios</p>
                      <p class="mega-menu__description">
                        Cuatro frentes de trabajo, un mismo estándar técnico ORINCOL.
                      </p>
                      <a class="mega-menu__cta" href="/servicios/">
                        Ver todos los servicios
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                    <div class="mega-menu__columns">
                      {services.map((service) => (
                        <div class="mega-menu__column">
                          <a class="mega-menu__column-title" href={`/servicios/${service.slug}/`}>
                            {megaMenuLabels[service.slug] ?? service.title}
                          </a>
                          <ul class="mega-menu__column-list">
                            {service.areas.map((area) => (
                              <li>
                                <a href={`/servicios/${service.slug}/#${slugify(area.title)}`}>
                                  {area.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li class="site-header__nav-item">
                <a class="site-header__nav-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <button
      type="button"
      class="site-header__toggle"
      id="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <MobileMenu />
</header>

<script>
  import "../scripts/header";
</script>
