---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section class="projects section" id="proyectos" aria-labelledby="projects-title">
  <div class="projects__header container">
    <div>
      <p class="eyebrow">Selección de obra</p>
      <h2 id="projects-title">Proyectos que dejan huella.</h2>
    </div>
    <a class="text-link" href="/proyectos/">Ver portafolio completo <span aria-hidden="true">↗</span></a>
  </div>
  <div class="projects__grid container">
    <ProjectCard project={projects[0]} variant="featured" />
    <ProjectCard project={projects[1]} />
    <ProjectCard project={projects[2]} />
    <ProjectCard project={projects[3]} variant="featured" />
  </div>
</section>
