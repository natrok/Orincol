---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section class="projects section" id="proyectos" aria-labelledby="projects-title">
  <div class="projects__header container">
    <div>
      <p class="eyebrow">Selección de obra</p>
      <h2 id="projects-title">Proyectos que dejan huella.</h2>
    </div>
    <a class="text-link" href="/proyectos/">Ver portafolio completo <span aria-hidden="true">↗</span></a>
  </div>
  <div class="projects__grid container">
    <ProjectCard project={projects[0]} variant="featured" />
    <ProjectCard project={projects[1]} />
    <ProjectCard project={projects[2]} />
    <ProjectCard project={projects[3]} variant="featured" />
  </div>
</section>

<style>
  .projects {
    background: var(--color-surface);
  }

  .projects__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: -0.05em;
    line-height: var(--leading-tight);
  }

  .text-link {
    display: inline-flex;
    flex-shrink: 0;
    gap: var(--space-3);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    color: var(--color-accent);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem) var(--space-8);
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .projects__grid :global(.project-card:nth-child(1)) {
    grid-column: 1 / span 7;
  }

  .projects__grid :global(.project-card:nth-child(2)) {
    grid-column: 9 / span 4;
    margin-top: 10rem;
  }

  .projects__grid :global(.project-card:nth-child(3)) {
    grid-column: 2 / span 4;
    margin-top: -3rem;
  }

  .projects__grid :global(.project-card:nth-child(4)) {
    grid-column: 7 / span 6;
    margin-top: 8rem;
  }

  @media (max-width: 48rem) {
    .projects__header {
      align-items: start;
      flex-direction: column;
    }

    .projects__grid {
      display: block;
    }

    .projects__grid :global(.project-card) {
      margin: 0 0 var(--space-12);
    }
  }
</style>
