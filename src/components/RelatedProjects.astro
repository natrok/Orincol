---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  category?: string;
}

const { category } = Astro.props;
const relatedProjects = category
  ? projects.filter((project) => project.category === category || project.portfolioCategory === category)
  : projects.slice(0, 2);
---

<section class="related-projects section container" aria-labelledby="related-projects-title">
  <div class="related-projects__heading">
    <div>
      <p class="eyebrow">Experiencia relacionada</p>
      <h2 id="related-projects-title">Obra que habla por nosotros.</h2>
    </div>
    <a class="text-link" href="/proyectos/">Ver todos los proyectos <span aria-hidden="true">↗</span></a>
  </div>
  <div class="related-projects__grid">
    {relatedProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .related-projects { background: var(--color-bg); }
  .related-projects__heading { display: flex; justify-content: space-between; align-items: end; gap: var(--space-8); }
  .related-projects h2 { max-width: 14ch; margin: 0; font-size: var(--text-2xl); line-height: var(--leading-tight); letter-spacing: -0.05em; }
  .related-projects__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); margin-top: var(--space-12); }
  @media (max-width: 48rem) {
    .related-projects__heading { align-items: start; flex-direction: column; }
    .related-projects__grid { grid-template-columns: 1fr; }
  }
</style>
