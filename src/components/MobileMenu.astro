---
import { headerNavigation } from "../data/navigation";
import { services } from "../data/services";

const megaMenuLabels: Record<string, string> = {
  consultoria: "Consultoría y Diseño",
  construccion: "Construcción",
  interventoria: "Interventoría",
  alquiler: "Alquiler",
};
---

<div class="mobile-menu" id="mobile-menu" data-open="false" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div class="mobile-menu__header container">
    <span class="mobile-menu__logo">ORINCOL</span>
    <button type="button" class="mobile-menu__close" data-mobile-close aria-label="Cerrar menú">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M1 1l16 16M17 1L1 17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav class="mobile-menu__nav container" aria-label="Navegación principal (móvil)">
    <ul class="mobile-menu__list">
      {
        headerNavigation.map((item) =>
          item.children ? (
            <li class="mobile-menu__item">
              <button type="button" class="mobile-menu__link" aria-expanded="false" data-accordion-toggle>
                {item.label}
                <svg class="mobile-menu__chevron" width="12" height="7" viewBox="0 0 12 7" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="mobile-menu__accordion" data-accordion-panel>
                <ul class="mobile-menu__sublist">
                  {services.map((service) => (
                    <li class="mobile-menu__service">
                      <a class="mobile-menu__service-title" href={`/servicios/${service.slug}/`}>
                        {megaMenuLabels[service.slug] ?? service.title}
                      </a>
                      <ul class="mobile-menu__service-areas">
                        {service.areas.map((area) => (
                          <li>
                            <a href={`/servicios/${service.slug}/`}>{area.title}</a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li class="mobile-menu__item">
              <a class="mobile-menu__link" href={item.href}>
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>
  </nav>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.3s ease, opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu[data-open="true"] {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  .mobile-menu__logo {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .mobile-menu__close {
    background: none;
    border: none;
    padding: var(--space-2);
    cursor: pointer;
  }

  .mobile-menu__nav {
    padding-block: var(--space-6) var(--space-16);
  }

  .mobile-menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__item {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu__link {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    background: none;
    border: none;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .mobile-menu__chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .mobile-menu__link[aria-expanded="true"] .mobile-menu__chevron {
    transform: rotate(180deg);
  }

  .mobile-menu__accordion {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
  }

  .mobile-menu__item:has(.mobile-menu__link[aria-expanded="true"]) .mobile-menu__accordion {
    grid-template-rows: 1fr;
  }

  .mobile-menu__accordion > * {
    overflow: hidden;
  }

  .mobile-menu__sublist {
    margin: 0;
    padding: 0 0 var(--space-6);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .mobile-menu__service-title {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-primary);
  }

  .mobile-menu__service-areas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-menu__service-areas a {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const accordionToggles = document.querySelectorAll<HTMLButtonElement>("[data-accordion-toggle]");

  accordionToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
    });
  });
</script>
