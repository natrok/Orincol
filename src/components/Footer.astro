---
import { footerNavigation } from "../data/navigation";

const year = new Date().getFullYear();

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/" },
  { label: "YouTube", href: "https://www.youtube.com/" },
  { label: "Instagram", href: "https://www.instagram.com/" },
];

const legalLinks = [
  { label: "Términos y condiciones", href: "/terminos/" },
  { label: "Política de privacidad", href: "/privacidad/" },
];
---

<footer class="site-footer">
  <div class="site-footer__main container">
    <div class="site-footer__brand">
      <p class="site-footer__logo">ORINCOL</p>
      <p class="site-footer__description">
        ORINCOL S.A.S. es una empresa colombiana de ingeniería civil e infraestructura,
        especializada en consultoría, construcción, interventoría y alquiler de equipos
        para proyectos que exigen precisión técnica y confianza a largo plazo.
      </p>
      <ul class="site-footer__social">
        {
          socialLinks.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      footerNavigation.map((column) => (
        <div class="site-footer__column">
          <p class="site-footer__column-title">{column.title}</p>
          <ul class="site-footer__links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner container">
      <p>&copy; {year} ORINCOL S.A.S. Todos los derechos reservados.</p>
      <ul class="site-footer__legal">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .site-footer__main {
    display: grid;
    gap: var(--space-12);
    grid-template-columns: 1fr;
    padding-block: var(--spacing-section);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .site-footer__logo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: 0.08em;
  }

  .site-footer__description {
    margin: 0;
    max-width: 32rem;
    color: rgb(246 245 241 / 72%);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-6);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__social a {
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid rgb(246 245 241 / 35%);
    padding-bottom: var(--space-1);
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  .site-footer__column-title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(246 245 241 / 60%);
  }

  .site-footer__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__links a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: rgb(246 245 241 / 88%);
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    border-top: 1px solid rgb(246 245 241 / 16%);
  }

  .site-footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    font-size: var(--text-xs);
    color: rgb(246 245 241 / 64%);
  }

  .site-footer__bottom-inner p {
    margin: 0;
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__legal a {
    text-decoration: none;
    color: inherit;
  }

  .site-footer__legal a:hover,
  .site-footer__legal a:focus-visible {
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }
</style>
