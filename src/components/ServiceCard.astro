---
import type { ServicePillar } from "../data/services";

interface Props {
  service: ServicePillar;
}

const { service } = Astro.props;
---

<article class="service-card">
  <div class="service-card__body">
    <h3><a href={`/servicios/${service.slug}/`}>{service.title}</a></h3>
    <p>{service.description}</p>
    <a class="service-card__link" href={`/servicios/${service.slug}/`}>
      Explorar servicio <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
