---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InternalHero from "../../components/InternalHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";

const filters = ["Todos", "Edificaciones", "Obras hidráulicas", "Vías", "Interventoría"];
---

<BaseLayout
  title="Proyectos | ORINCOL S.A.S."
  description="Portafolio de proyectos de ingeniería civil e infraestructura de ORINCOL S.A.S."
>
  <InternalHero
    eyebrow="Portafolio ORINCOL"
    title="Infraestructura con intención."
    description="Una selección de proyectos de ejemplo preparada para crecer con la experiencia real de ORINCOL."
  />
  <section class="portfolio section container" aria-labelledby="portfolio-title">
    <div class="portfolio__heading">
      <div>
        <p class="eyebrow">Selección de obra</p>
        <h2 id="portfolio-title">Explorar proyectos.</h2>
      </div>
      <div class="portfolio__filters" role="group" aria-label="Filtrar proyectos">
        {filters.map((filter, index) => (
          <button type="button" class:list={{ "is-active": index === 0 }} data-filter={filter}>
            {filter}
          </button>
        ))}
      </div>
    </div>
    <div class="portfolio__grid">
      {projects.map((project) => (
        <div data-project-card data-category={project.portfolioCategory}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
    <p class="portfolio__empty" data-empty hidden>No hay proyectos disponibles para este filtro.</p>
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selected = filter.dataset.filter ?? "Todos";
      filters.forEach((button) => button.classList.toggle("is-active", button === filter));
      let visible = 0;
      cards.forEach((card) => {
        const matches = selected === "Todos" || card.dataset.category === selected;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .portfolio__heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-8); }
  .portfolio h2 { margin: 0; font-size: var(--text-2xl); letter-spacing: -.05em; line-height: var(--leading-tight); }
  .portfolio__filters { display: flex; flex-wrap: wrap; justify-content: end; gap: var(--space-2); }
  .portfolio__filters button { padding: .6rem .8rem; border: 1px solid var(--color-border); background: transparent; color: var(--color-muted); font-size: var(--text-sm); cursor: pointer; }
  .portfolio__filters button:hover, .portfolio__filters button.is-active { border-color: var(--color-primary); background: var(--color-primary); color: var(--color-bg); }
  .portfolio__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12) var(--space-8); margin-top: var(--space-12); }
  .portfolio__empty { margin-top: var(--space-12); color: var(--color-muted); }
  @media (max-width: 48rem) {
    .portfolio__heading { align-items: start; flex-direction: column; }
    .portfolio__filters { justify-content: start; }
    .portfolio__grid { grid-template-columns: 1fr; }
  }
</style>
