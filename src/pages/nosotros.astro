---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "../components/InternalHero.astro";
---

<BaseLayout title="Nosotros | ORINCOL S.A.S." description="Conoce la visión institucional y metodología de ORINCOL S.A.S.">
  <InternalHero
    eyebrow="Nosotros"
    title="Ingeniería con criterio, ejecución y cuidado."
    description="ORINCOL S.A.S. desarrolla soluciones de ingeniería civil e infraestructura con una mirada responsable sobre cada territorio."
  />
  <section class="about section container">
    <div class="about__lead">
      <p class="eyebrow">Presentación institucional</p>
      <h2>Construir bien también es entender el contexto.</h2>
    </div>
    <div class="about__copy">
      <p>Trabajamos para convertir necesidades de infraestructura en decisiones claras y proyectos ejecutables.</p>
      <p>La historia, cifras corporativas, certificaciones y años de experiencia serán incorporados una vez sean validados por ORINCOL.</p>
    </div>
  </section>
  <section class="values section" aria-labelledby="values-title">
    <div class="container">
      <p class="eyebrow">Principios</p><h2 id="values-title">Valores que sostienen cada entrega.</h2>
      <div class="values__grid">
        {["Rigor técnico", "Transparencia", "Cuidado del territorio", "Trabajo colaborativo"].map((value) => <article><h3>{value}</h3><p>Una práctica diaria para tomar mejores decisiones de proyecto.</p></article>)}
      </div>
    </div>
  </section>
  <section class="method section container" aria-labelledby="method-title">
    <div><p class="eyebrow">Metodología</p><h2 id="method-title">De la lectura inicial a la entrega.</h2></div>
    <ol><li><b>Entender</b><span>Leemos el reto, el lugar y sus restricciones.</span></li><li><b>Diseñar</b><span>Ordenamos alternativas con criterio técnico.</span></li><li><b>Ejecutar</b><span>Coordinamos equipos, recursos y control.</span></li><li><b>Verificar</b><span>Medimos la calidad y dejamos trazabilidad.</span></li></ol>
  </section>
  <section class="timeline section container" aria-labelledby="timeline-title">
    <p class="eyebrow">Historia ORINCOL</p><h2 id="timeline-title">Una línea de tiempo preparada para la historia real.</h2>
    <div class="timeline__placeholder">[DATOS PENDIENTES] Hitos, fechas y evolución institucional.</div>
  </section>
</BaseLayout>

<style>
  .about, .method { display: grid; grid-template-columns: minmax(14rem, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 9vw, 9rem); }
  h2 { max-width: 14ch; margin: 0; font-size: var(--text-2xl); line-height: var(--leading-tight); letter-spacing: -.05em; }
  .about__copy { max-width: 38rem; font-size: var(--text-lg); } .about__copy p + p { color: var(--color-muted); font-size: var(--text-base); }
  .values { background: var(--color-surface); } .values__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); margin-top: var(--space-12); }
  .values article { padding-top: var(--space-6); border-top: 1px solid var(--color-primary); } .values h3 { margin: 0; } .values p { color: var(--color-muted); }
  .method ol { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 var(--space-8); margin: 0; padding: 0; list-style: none; } .method li { display: grid; gap: var(--space-2); padding: var(--space-6) 0; border-top: 1px solid var(--color-border); } .method span { color: var(--color-muted); }
  .timeline { border-top: 1px solid var(--color-border); } .timeline__placeholder { margin-top: var(--space-8); padding: var(--space-8); background: var(--color-surface); color: var(--color-muted); }
  @media (max-width: 48rem) { .about, .method { display: block; } .about__copy, .method ol { margin-top: var(--space-12); } .values__grid, .method ol { grid-template-columns: 1fr; } }
</style>
