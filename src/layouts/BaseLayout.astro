---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Renders the header transparent over a full-bleed hero until the user scrolls. */
  transparentHeader?: boolean;
}

const {
  title = "ORINCOL S.A.S. | Ingeniería que construye futuro",
  description = "ORINCOL S.A.S. desarrolla soluciones de ingeniería civil e infraestructura en Colombia.",
  canonical,
  transparentHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <SEO title={title} description={description} canonical={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header transparent={transparentHeader} />
    <main id="main-content" class={transparentHeader ? "" : "has-fixed-header-offset"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
